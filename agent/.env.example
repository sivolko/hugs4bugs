# ── Anthropic Claude ──────────────────────────────────────────────────────────
# Get your API key at: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Claude model ID — check latest at: https://docs.anthropic.com/en/docs/about-claude/models
# claude-sonnet-4-5 is the current Sonnet tier
CLAUDE_MODEL=claude-sonnet-4-5

# ── Blog GitHub Repo ─────────────────────────────────────────────────────────
# The Jekyll blog GitHub repository where drafts will be committed.
# Since agent and blog share the same repo, this is fixed.
BLOG_GITHUB_REPO=sivolko/hugs4bugs

# GitHub Personal Access Token with "Contents: Read and Write" scope.
# For GitHub Actions: this is automatically provided as secrets.GITHUB_TOKEN
# For local runs: create one at https://github.com/settings/tokens/new
BLOG_GITHUB_TOKEN=ghp_your_token_here

# ── Email Notification ───────────────────────────────────────────────────────
EMAIL_TO=shubhendushubham98@gmail.com
EMAIL_FROM=shubhendushubham98@gmail.com

# Gmail App Password (NOT your regular Gmail password).
# Steps: Gmail -> Account -> Security -> 2-Step Verification ON -> App Passwords
EMAIL_APP_PASSWORD=your_gmail_app_password_here

# ── Agent Behaviour (optional overrides) ─────────────────────────────────────
LOOKBACK_HOURS=24
MAX_STORIES=5
BLOG_BRANCH=main
DRAFTS_PATH=_drafts
